# Instalar em /etc/systemd/system/emailing.service
#
# Roda com usuário de sistema próprio, nunca como root: o processo guarda a
# credencial do SMTP e pode enviar e-mail com DMARC alinhado pelo domínio.
# Criar antes: useradd --system --no-create-home --shell /usr/sbin/nologin emailing

[Unit]
Description=Emailing — envio de e-mail por alias (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=emailing
Group=www-data
WorkingDirectory=/var/www/emailing
EnvironmentFile=/var/www/emailing/.env
ExecStart=/var/www/emailing/.venv/bin/gunicorn config.wsgi \
    --bind 127.0.0.1:8010 \
    --workers 2 --threads 4 \
    --timeout 60 --graceful-timeout 20 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=emailing

# Só o diretório de estado é gravável: banco, assinaturas e anexos pendentes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/emailing/data

[Install]
WantedBy=multi-user.target
