# Copie para .env e preencha. Em produção este mesmo arquivo é lido pelo
# systemd via EnvironmentFile= — por isso NÃO use valores multilinha nem
# expansão de shell aqui.

# --- Django / operacional -------------------------------------------------
SECRET_KEY=""
DEBUG="0"
ALLOWED_HOSTS="emailing.leonardocosta.dev"
# Vazia → deriva https://<host> de cada host de ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=""
TIME_ZONE="America/Belem"
# Fuso do processo. Sem ele o cabeçalho Date: sai "-0000".
TZ="America/Belem"
# Raiz do estado: banco, assinaturas e anexos pendentes.
DATA_DIR="/var/www/emailing/data"
SESSION_COOKIE_AGE="43200"
ARGON2_MEMORY_KIB="19456"

# --- SMTP global (fallback de todos os aliases) ---------------------------
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT="587"
# A caixa REAL que autentica. Também define o padrão de ALIAS_ALLOWED_DOMAINS.
SMTP_USER="me@leonardocosta.dev"
SMTP_PASSWORD=""
SMTP_USE_TLS="1"
SMTP_USE_SSL="0"
# O padrão do Django é None = bloqueia a thread para sempre.
SMTP_TIMEOUT="20"
# Se definida, vira o MAIL FROM no lugar do alias. Escotilha caso o Titan
# passe a rejeitar envelope de alias.
SMTP_ENVELOPE_FROM=""

# --- Aliases --------------------------------------------------------------
# Slugs por vírgula. A ordem é a ordem do seletor; o primeiro vem selecionado.
ALIASES="financeiro,contato"
# Domínios que um alias pode usar. O boot FALHA com qualquer outro — é a trava
# de DMARC. Vazia → domínio de SMTP_USER.
ALIAS_ALLOWED_DOMAINS="leonardocosta.dev"

# Por alias: <SLUG> é o slug em maiúsculas, não-alfanumérico virando "_".
# Rode `manage.py verificar_config` para ver o nome exato que ele procurou.
ALIAS_FINANCEIRO_ADDRESS="financeiro@leonardocosta.dev"
ALIAS_FINANCEIRO_NAME="Leonardo Costa"
# Opcionais:
# ALIAS_FINANCEIRO_REPLY_TO=""
# ALIAS_FINANCEIRO_SIGNATURE_FILE="financeiro.html"   (padrão: <slug>.html)
# ALIAS_FINANCEIRO_SIGNATURE_HTML=""                  (uma linha; vence o arquivo)
# ALIAS_FINANCEIRO_SMTP_HOST / _PORT / _USER / _PASSWORD / _USE_TLS / _USE_SSL

ALIAS_CONTATO_ADDRESS="contato@leonardocosta.dev"
ALIAS_CONTATO_NAME="Leonardo Costa"

# Onde ficam os <slug>.html. Vazio → <DATA_DIR>/assinaturas
SIGNATURES_DIR=""
# Lado direito do Message-ID e nome do EHLO. Vazio → domínio do alias remetente.
MESSAGE_ID_DOMAIN=""

# --- Composição, anexos e limites -----------------------------------------
EML_MAX_BYTES="5242880"
MAX_DESTINATARIOS="50"
CITACAO_MAX_BYTES="102400"
ANEXOS_MAX_ARQUIVOS="10"
ANEXO_MAX_BYTES="15728640"
ANEXOS_MAX_TOTAL_BYTES="18874368"
ANEXOS_EXTENSOES_BLOQUEADAS="exe,bat,cmd,com,scr,js,vbs,jar,msi,ps1"
RASCUNHOS_TTL_DIAS="7"
HOSTS_IMAGENS_ASSINATURA="https://gravatar.com https://cdn.jsdelivr.net"
GUARDAR_CORPO_ENVIADO="1"

# --- Envio programado -----------------------------------------------------
# Teto por execução do cron. Hostinger e Titan contam saída por hora e por dia:
# um lote grande de uma vez vira fila de FALHOU em vez de atraso.
AGENDADOS_MAX_POR_EXECUCAO="20"
AGENDADOS_MAX_TENTATIVAS="3"
# Espera antes de tentar de novo, dobrando a cada tentativa (5, 10, 20 min).
AGENDADOS_BACKOFF_MINUTOS="5"
# Atraso máximo tolerado. Servidor fora do ar dois dias: disparar o acumulado ao
# voltar é pior do que não disparar. "0" desliga e manda de qualquer jeito.
AGENDADOS_TOLERANCIA_HORAS="24"
# Para onde avisar quando um agendamento esgota as tentativas. Vazio = não avisa
# (fica no histórico, mas ninguém lê o histórico às 3h da manhã).
AGENDADOS_AVISAR_PARA=""
# Alias que manda o aviso. Vazio = o do próprio agendamento, que pode ser
# justamente o que está com credencial quebrada.
AGENDADOS_AVISAR_ALIAS=""

# --- Segurança ------------------------------------------------------------
AXES_FAILURE_LIMIT="5"
AXES_COOLOFF_HORAS="1"
# "0" só em desenvolvimento.
OTP_OBRIGATORIO="1"
